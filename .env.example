# -------------------------------------------------------------------- Stripe
# Developers → API keys. Use the test key (sk_test_...) until you're ready.
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or the endpoint's signing secret in the dashboard for production.
STRIPE_WEBHOOK_SECRET=

# You are the merchant of record, so sales tax/VAT is yours to handle. Set this
# to "true" only AFTER configuring Stripe Tax in the dashboard (origin address
# plus at least one registration) — Checkout rejects the session otherwise.
STRIPE_AUTOMATIC_TAX=false

# Absolute URL of the deployment — used for checkout redirects and OG tags
NEXT_PUBLIC_SITE_URL=https://hireme.fit

# Moderation. Without this set, /admin returns 404 and no admin surface exists.
# Use something long and random: `openssl rand -hex 32`
ADMIN_TOKEN=
