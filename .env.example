# --------------------------------------------------------------------- Polar
# Organization access token (Settings → Developers → New token).
POLAR_ACCESS_TOKEN=
# "sandbox" until you're ready to take real money; anything else = production.
# Sandbox tokens come from sandbox.polar.sh and are NOT interchangeable.
POLAR_SERVER=sandbox

# One product in the Polar dashboard covers the whole app — call it whatever you
# like ("HireMe.lol Rank"). Its catalog price doesn't matter: every checkout
# sends an ad-hoc USD price, so the amount is always the one the server computed
# and the buyer can't edit it at checkout.
POLAR_PRODUCT_ID=

# Webhook endpoint secret (Settings → Webhooks → add /api/polar/webhook,
# subscribe to `order.paid`).
POLAR_WEBHOOK_SECRET=

# Absolute URL of the deployment — used for checkout redirects and OG tags
NEXT_PUBLIC_SITE_URL=https://hireme.fit
