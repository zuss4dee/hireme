# ---------------------------------------------------------------------------
# HireMe.lol
# Everything below is OPTIONAL. With no .env.local the app runs end-to-end on
# a seeded in-memory store with simulated payments, so you can click the whole
# product immediately. Fill these in to go real.
# ---------------------------------------------------------------------------

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------- Polar
# Organization access token (Settings → Developers → New token).
POLAR_ACCESS_TOKEN=
# "sandbox" until you're ready to take real money; anything else = production.
# Sandbox tokens come from sandbox.polar.sh and are NOT interchangeable.
POLAR_SERVER=sandbox

# Two products you create in the Polar dashboard:
#  1. "Leaderboard bid"  — one-time, PAY WHAT YOU WANT (the bidder sets the amount)
#  2. "Unlock candidate" — one-time, FIXED price of £25
# Enable GBP on both, otherwise Polar falls back to your org's default currency
# and the pence amounts this app sends get read as that currency's minor units.
POLAR_BID_PRODUCT_ID=
POLAR_UNLOCK_PRODUCT_ID=

# Webhook endpoint secret (Settings → Webhooks → add /api/polar/webhook,
# subscribe to `order.paid`).
POLAR_WEBHOOK_SECRET=

# Absolute URL of the deployment — used for checkout redirects and OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
